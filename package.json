{
  "name": "eslint-config-narwhal",
  "version": "2.1.17",
  "description": "SonarJS + Unicorn — with resolved conflicts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/smoke.test.ts",
    "sync": "node scripts/sync-narwhal.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "unicorn",
    "sonarjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredcat/eslint-config-narwhal.git"
  },
  "bugs": {
    "url": "https://github.com/jaredcat/eslint-config-narwhal/issues"
  },
  "homepage": "https://github.com/jaredcat/eslint-config-narwhal#readme",
  "peerDependencies": {
    "eslint": "^10.15.0",
    "typescript-eslint": "^8.74.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.3",
  "publishConfig": {
    "access": "public"
  }
}
